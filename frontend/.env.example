# Copy this file to ".env" (same folder) before running "npm run dev".
# On Windows:  copy .env.example .env
#
# The URL of the Django API, including "/api" and WITHOUT a trailing slash.
# Local development:
VITE_API_URL=http://127.0.0.1:8000/api
# After deploying the backend on Render, use your Render address (set this in Vercel, not here):
# VITE_API_URL=https://your-fittrack-api.onrender.com/api
